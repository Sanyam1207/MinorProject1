# Leave empty to call the API on the same origin (Vite dev proxy → backend :8000).
# Set to e.g. https://api.example.edu when the API is hosted separately.
VITE_API_BASE_URL=
# Where the dev proxy forwards /api and /socket.io (default http://127.0.0.1:8000).
VITE_DEV_BACKEND_URL=
# Google Identity Services client id (same OAuth client as the backend CLIENT_ID).
VITE_GOOGLE_CLIENT_ID=
VITE_APP_NAME=Matchy Campus
