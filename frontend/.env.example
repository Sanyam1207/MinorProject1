# Backend origin WITHOUT /api/v1. Leave empty to call the API on the same origin
# (Vite dev proxy → backend, or a production reverse proxy serving /api and /socket.io).
# Set to e.g. https://api.example.edu when the API is hosted separately (CORS must allow this app's origin).
VITE_API_BASE_URL=

# Dev server only: where the proxy forwards /api and /socket.io (default http://127.0.0.1:8000).
VITE_DEV_BACKEND_URL=

# Google Identity Services web client id — must equal the backend CLIENT_ID.
# Leave empty to hide "Continue with Google".
VITE_GOOGLE_CLIENT_ID=

# Product name shown in the header, sign-in screen, welcome message and tab title.
VITE_APP_NAME=Matchy Campus

# Set by `npm run dev:lan` (HTTPS on the LAN for phones, after `npm run cert`); do not set by hand.
# VITE_DEV_HOST=lan
# VITE_DEV_HTTPS=true
