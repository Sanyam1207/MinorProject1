# Copy to backend/.env and fill in. Never commit the real file.

# ── Server ───────────────────────────────────────────────────────────────────
PORT=8000
NODE_ENV=development
APP_NAME=Matchy Campus
APP_TIMEZONE=Asia/Kolkata
FRONTEND_URL=http://localhost:5173
# Comma-separated allowed origins; "*" reflects any origin (local dev only).
CORS=*
MONGO_URI=mongodb://127.0.0.1:27017
DB_NAME=minor_project

# ── Auth (generate secrets with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))") ──
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRY=10d
# strict | lax | none (none requires HTTPS; only when web app and API are on different sites)
AUTH_COOKIE_SAMESITE=strict
PASSWORD_RESET_TTL_MINUTES=30
TEMP_PASSWORD_TTL_DAYS=7
# Bootstrap TPO account (first password registration of this email becomes the college TPO)
TPO_EMAIL=
TPO_INITIAL_PASSWORD=
# Comma-separated emails that become teachers on first registration
TEACHER_EMAILS=
# Google sign-in + Gmail (PR outreach) OAuth client
CLIENT_ID=
CLIENT_SECRET=
GOOGLE_GMAIL_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/gmail/callback
GOOGLE_REQUIRE_HOSTED_DOMAIN=false
# 64 hex chars (Gmail refresh tokens, WhatsApp login state)
TOKEN_ENCRYPTION_KEY=

# ── AI agent service ─────────────────────────────────────────────────────────
AI_SERVICE_URL=http://127.0.0.1:9000
# Same value as ai-service/.env AI_SERVICE_TOKEN
AI_SERVICE_TOKEN=
AI_IDLE_TIMEOUT_MS=120000
# Signs the short-lived tokens the copilot uses to call /api/v1/agent-tools
AGENT_TOOL_SECRET=
AGENT_TOOL_TOKEN_TTL=15m
INTERNAL_API_URL=http://127.0.0.1:8000

# ── Email (password reset, invites, notification emails) ─────────────────────
SMTP_SERVICE=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── Web push (generate with: npx web-push generate-vapid-keys) ────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.edu

# ── Attendance ───────────────────────────────────────────────────────────────
ATTENDANCE_DEVICE_SECRET=
WORK_DAY_START=09:00
WORK_DAY_END=17:00
# 0=Sun … 6=Sat
WORK_DAYS=1,2,3,4,5,6

# ── Placements ───────────────────────────────────────────────────────────────
ACADEMIC_YEAR_START_MONTH=7
PLACEMENT_SWEEP_INTERVAL_MS=300000
OFFER_REMINDER_HOURS=24
DRIVE_DEADLINE_REMINDER_HOURS=24
PLACEMENT_COMPANY_AUTO_APPROVE=false
PLACEMENT_ANNOUNCE_MAX_RECIPIENTS=5000

# ── Open-market job feed (ported from Matchy) ─────────────────────────────────
JOB_SYNC_INTERVAL_MINUTES=60
JOB_SYNC_ON_BOOT=true
JOB_FEED_RETENTION_DAYS=45
JOB_FEED_MATCH_DIGEST=true
# Optional header secret for cron-triggered syncs (POST /api/v1/job-feed/sync)
ADMIN_SYNC_SECRET=
FROM_ARTHA=false
ARTHA_KEYWORDS=
ARTHA_LOCATION=IN
ARTHA_COUNTRIES=
# Unofficial WhatsApp client — off by default (account ban risk; use a spare number)
WHATSAPP_ENABLED=false
WHATSAPP_CHANNELS=
WHATSAPP_LLM_EMAIL=
WHATSAPP_LLM_PROVIDER=
WHATSAPP_LLM_MODEL=
WHATSAPP_PAIRING_NUMBER=

# ── Resumes + bring-your-own LLM keys ────────────────────────────────────────
# local | cloudinary | uploadthing
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
MAX_RESUME_SIZE_BYTES=5242880
TECTONIC_BIN=
LATEX_COMPILE_TIMEOUT_MS=60000
UPLOADTHING_TOKEN=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_RESUME_FOLDER=tnp-ai/resumes
# base64 of 32 random bytes: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
LLM_CREDENTIAL_ENCRYPTION_KEY=

# ── Demo seed (npm run seed:demo) ────────────────────────────────────────────
DEMO_PASSWORD=
# Optional: your address becomes the demo TPO; you+teacher/+student/+recruiter the other roles
DEMO_OWNER_EMAIL=
